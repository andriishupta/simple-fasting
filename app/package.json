{
  "name": "app",
  "main": "index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "^56.0.20",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "expo-widgets": "~56.0.19",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-gifted-charts": "1.4.63",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "content:sync": "node ../scripts/sync-shared-content.mjs",
    "content:check": "node ../scripts/sync-shared-content.mjs --check",
    "prebuild": "node ../scripts/sync-shared-content.mjs && expo prebuild",
    "eas-build-pre-install": "node ../scripts/sync-shared-content.mjs",
    "prestart": "node ../scripts/sync-shared-content.mjs",
    "start": "expo start",
    "preandroid": "node ../scripts/sync-shared-content.mjs",
    "android": "expo run:android",
    "preios": "node ../scripts/sync-shared-content.mjs",
    "ios": "expo run:ios",
    "preweb": "node ../scripts/sync-shared-content.mjs",
    "web": "expo start --web",
    "lint": "node ../scripts/sync-shared-content.mjs --check && expo lint",
    "test": "node ../scripts/sync-shared-content.mjs --check && jest --runInBand --no-watchman",
    "test:coverage": "node ../scripts/sync-shared-content.mjs --check && jest --runInBand --no-watchman --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-mock.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|react-navigation|@react-navigation/.*|react-native-svg|react-native-reanimated|react-native-gesture-handler|lucide-react-native))"
    ],
    "collectCoverageFrom": [
      "src/storage/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}",
      "src/widgets/fasting-widget-model.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "private": true
}
