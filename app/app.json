{
  "expo": {
    "name": "Simple Fasting",
    "slug": "simple-fasting-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simple-fasting",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.simplefasting",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.simplefasting",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon-light.png",
            "imageWidth": 76,
            "dark": {
              "backgroundColor": "#000000",
              "image": "./assets/images/splash-icon-dark.png"
            }
          }
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FastingWidget",
              "displayName": "Simple Fasting",
              "description": "See your active fast or open the app to start one.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/with-widget-version",
      "./plugins/with-ios-react-native-source-build",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FastingWidget",
              "label": "Simple Fasting",
              "description": "See your active fast or open the app to start one.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-mail-composer",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en"
            ],
            "android": [
              "en"
            ]
          }
        }
      ]
    ],
    "locales": {
      "en": "./src/locales/native/en.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "storeLinks": {
        "appStoreReview": null,
        "playStoreReview": null
      },
      "eas": {
        "projectId": "bde3ec07-6159-4be2-aa8d-fda6ee15e207"
      }
    },
    "owner": "simple-fasting"
  }
}
